{
  "name": "playwright-synthetic-plugin",
  "version": "0.1.0",
  "description": "Playwright plugin that turns E2E journeys into production synthetic checks, with safety guardrails and OpenTelemetry/Prometheus metrics",
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "synthetic-monitoring",
    "observability",
    "opentelemetry",
    "otlp",
    "prometheus",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EmanueleMinotto/playwright-synthetic-plugin"
  },
  "homepage": "https://github.com/EmanueleMinotto/playwright-synthetic-plugin#readme",
  "bugs": {
    "url": "https://github.com/EmanueleMinotto/playwright-synthetic-plugin/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "require": "./dist/reporter.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:e2e": "playwright test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.42.0"
  },
  "dependencies": {
    "picomatch": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/picomatch": "^3.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0"
  }
}
